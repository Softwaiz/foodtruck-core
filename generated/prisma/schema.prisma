datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

model User {
  id        String    @unique() @default(uuid())
  firstName String
  lastName  String
  email     String
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  trucks Truck[]
}

model Truck {
  id          String    @unique @default(uuid())
  logo        Json?
  name        String
  description String
  cuisineType String
  phoneNumber String
  website     String
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime?
}

model TruckLocation {
  id        String    @unique @default(uuid())
  latitude  Decimal
  longitude Decimal
  createdAt DateTime  @default(now())
  updatedAt DateTime?
}
